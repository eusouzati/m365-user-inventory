# Microsoft 365 local authentication
# Required only when running: python src/main.py
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Azure deployment target
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=brazilsouth
AZURE_RESOURCE_GROUP=rg-m365-user-inventory

# Azure resource names
# Leave storage and function app empty to generate globally unique names.
AZURE_STORAGE_ACCOUNT=
AZURE_FUNCTION_APP=
AZURE_MANAGED_IDENTITY_NAME=id-m365-user-inventory

# Inventory output and schedule
INVENTORY_CONTAINER=inventory
INVENTORY_BLOB_NAME=m365_users.csv
INVENTORY_SCHEDULE=0 0 11 * * *
